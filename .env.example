INFOCAP_LLM_PROVIDER=openai
INFOCAP_LLM_MODEL=gpt-4o
INFOCAP_LLM_API_KEY=sk-your-key-here
INFOCAP_LLM_BASE_URL=

INFOCAP_NEO4J_URI=bolt://localhost:7687
INFOCAP_NEO4J_USER=neo4j
INFOCAP_NEO4J_PASSWORD=infocap123

INFOCAP_CONTEXT_BUDGET_TOKENS=30000
INFOCAP_SUBCONSCIOUS_IDLE_SECONDS=300
INFOCAP_SUBCONSCIOUS_TIMER_SECONDS=1800

# === Platform Adapters ===
# Set *_ENABLED=true to activate, fill in credentials below

# Web UI (HTTP on port 8000, always on)
INFOCAP_PLATFORM_WEB_ENABLED=true

# WeChat — OpenClaw Gateway v3 (openclaw-weixin plugin connects here)
INFOCAP_PLATFORM_WECHAT_ENABLED=false
INFOCAP_PLATFORM_WECHAT_GATEWAY_HOST=127.0.0.1
INFOCAP_PLATFORM_WECHAT_GATEWAY_PORT=18789

# QQ — NapCatQQ OneBot v11 reverse WebSocket
INFOCAP_PLATFORM_QQ_ENABLED=false
INFOCAP_PLATFORM_QQ_HOST=0.0.0.0
INFOCAP_PLATFORM_QQ_PORT=8080
INFOCAP_PLATFORM_QQ_NAPCAT_HTTP=http://127.0.0.1:3000

# Telegram — python-telegram-bot
INFOCAP_PLATFORM_TELEGRAM_ENABLED=false
INFOCAP_PLATFORM_TELEGRAM_TOKEN=your_bot_token
INFOCAP_PLATFORM_TELEGRAM_ALLOWED_USERS=

# Discord — discord.py (prefix: !)
INFOCAP_PLATFORM_DISCORD_ENABLED=false
INFOCAP_PLATFORM_DISCORD_TOKEN=your_bot_token
INFOCAP_PLATFORM_DISCORD_CHANNELS=