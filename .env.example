# ==========================================
# Noesis — Environment Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# ==========================================

# ---- LLM (required) ----
NOESIS_LLM_PROVIDER=openai
NOESIS_LLM_MODEL=gpt-4o
NOESIS_LLM_API_KEY=sk-your-key-here
NOESIS_LLM_BASE_URL=

# ---- Neo4j ----
# Local dev:       bolt://localhost:7687
# Docker Compose:  bolt://neo4j:7687  (service name, override via compose env)
NOESIS_NEO4J_URI=bolt://localhost:7687
NOESIS_NEO4J_USER=neo4j
NOESIS_NEO4J_PASSWORD=noesis123

# ---- Web Server ----
# Local dev:       127.0.0.1
# Docker Compose:  0.0.0.0  (override via compose env)
NOESIS_WEB_HOST=127.0.0.1
NOESIS_WEB_PORT=8000
NOESIS_PLATFORM_WEB_ENABLED=true

# ---- Frontend (Docker Compose) ----
# Browser connects to backend at this address
# Docker Desktop:  localhost
# Linux host:      your host IP or localhost
NEXT_PUBLIC_API_HOST=localhost
# Frontend dev server port (Docker Compose only)
FRONTEND_PORT=3000

# ---- Context Budget ----
NOESIS_CONTEXT_BUDGET_TOKENS=30000
NOESIS_SUBCONSCIOUS_IDLE_SECONDS=300
NOESIS_SUBCONSCIOUS_TIMER_SECONDS=1800

# === Platform Adapters ===
# Set *_ENABLED=true to activate, fill in credentials below

# WeChat — direct iLink API (QR login, self-contained)
NOESIS_PLATFORM_WECHAT_ENABLED=false

# QQ — Tencent official botpy SDK (app_id + app_secret from QQ Open Platform)
NOESIS_PLATFORM_QQ_ENABLED=false
NOESIS_PLATFORM_QQ_APP_ID=
NOESIS_PLATFORM_QQ_APP_SECRET=
NOESIS_PLATFORM_QQ_ALLOWED_USERS=

# Telegram — python-telegram-bot
NOESIS_PLATFORM_TELEGRAM_ENABLED=false
NOESIS_PLATFORM_TELEGRAM_TOKEN=your_bot_token
NOESIS_PLATFORM_TELEGRAM_ALLOWED_USERS=

# Discord — discord.py (prefix: !)
NOESIS_PLATFORM_DISCORD_ENABLED=false
NOESIS_PLATFORM_DISCORD_TOKEN=your_bot_token
NOESIS_PLATFORM_DISCORD_CHANNELS=

# Feishu/Lark — lark-oapi SDK
NOESIS_PLATFORM_FEISHU_ENABLED=false
NOESIS_PLATFORM_FEISHU_APP_ID=
NOESIS_PLATFORM_FEISHU_APP_SECRET=
